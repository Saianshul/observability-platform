<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saved Reports | Observability</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f172a;
            --surface-color: rgba(30, 41, 59, 0.7);
            --primary-color: #3b82f6;
            --primary-hover: #2563eb;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        body { 
            font-family: 'Inter', system-ui, sans-serif; 
            background: var(--bg-color); 
            background-image: radial-gradient(circle at top right, rgba(59, 130, 246, 0.05), transparent 60%);
            margin: 0; 
            color: var(--text-main);
            min-height: 100vh;
        }

        .navbar {
            background: var(--surface-color);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .navbar h1 { margin: 0; font-size: 1.25rem; font-weight: 600; }
        .nav-links { display: flex; align-items: center; gap: 1.5rem; }
        .nav-links a { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
        .nav-links a:hover { color: var(--text-main); }
        .nav-links span { color: var(--text-main); font-weight: 500; font-size: 0.9rem; }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        .page-header { margin-bottom: 2rem; }
        .page-header h2 { margin: 0 0 0.5rem 0; font-size: 1.75rem; font-weight: 600; }
        .page-header p { margin: 0; color: var(--text-muted); font-size: 0.95rem; }

        .reports-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 1.5rem;
        }

        .report-card {
            background: var(--surface-color);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.5rem;
            transition: transform 0.2s, border-color 0.2s;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .report-card:hover {
            transform: translateY(-4px);
            border-color: rgba(59, 130, 246, 0.5);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .report-category {
            align-self: flex-start;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 1rem;
            background: rgba(59, 130, 246, 0.2);
            color: #93c5fd;
            border: 1px solid rgba(59, 130, 246, 0.5);
        }

        .report-card h3 {
            margin: 0 0 0.5rem 0;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .report-meta {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .report-comment {
            font-size: 0.9rem;
            color: #cbd5e1;
            line-height: 1.5;
            margin-bottom: 1.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex-grow: 1;
        }

        .report-actions a {
            display: inline-block;
            width: 100%;
            text-align: center;
            background: var(--primary-color);
            color: white;
            text-decoration: none;
            padding: 0.75rem;
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.9rem;
            transition: background 0.2s;
            box-sizing: border-box;
        }

        .report-actions a:hover {
            background: var(--primary-hover);
        }

        .btn-delete-report {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 50%;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-delete-report:hover {
            color: var(--danger-color, #ef4444);
            background: rgba(239, 68, 68, 0.1);
            transform: scale(1.1);
        }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 4rem;
            background: rgba(30, 41, 59, 0.3);
            border: 1px dashed var(--border-color);
            border-radius: 12px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <h1>Observability Platform</h1>
        <div class="nav-links">
            <% if (user.role === 'super_admin' || user.role === 'analyst') { %>
                <a href="/">Dashboard</a>
            <% } %>
            <span><%= user.username %> (<%= user.role.replace('_', ' ') %>)</span>
            <a href="/api/users/logout" style="color: #ef4444;">Logout</a>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h2>Saved Reports Archive</h2>
            <p>Access and download statically generated analytical PDFs.</p>
        </div>

        <div class="reports-grid">
            <% if (reports && reports.length > 0) { %>
                <% reports.forEach(report => { %>
                    <div class="report-card" id="report-card-<%= report.id %>">
                        <% if (user.role === 'super_admin' || user.role === 'analyst') { %>
                            <button class="btn-delete-report" onclick="deleteReport(<%= report.id %>)" title="Delete Report">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"></path>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                                </svg>
                            </button>
                        <% } %>
                        <span class="report-category"><%= report.category %></span>
                        <h3><%= report.title %></h3>
                        <div class="report-meta">
                            <span><strong>Author:</strong> @<%= report.author_name %></span>
                            <span><strong>Generated:</strong> <%= new Date(report.created_at).toLocaleString() %></span>
                        </div>
                        <div class="report-comment">
                            <%= report.comment || "No comment provided." %>
                        </div>
                        <div class="report-actions">
                            <a href="<%= report.file_path %>" target="_blank">View PDF Report</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <h3>No Reports Available</h3>
                    <p>There have been no static reports generated for the archive yet.</p>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        async function deleteReport(id) {
            if (!confirm('Are you sure you want to delete this report? This action cannot be undone.')) {
                return;
            }

            try {
                const res = await fetch(`/api/reports/saved/${id}`, {
                    method: 'DELETE',
                });

                if (res.ok) {
                    const card = document.getElementById(`report-card-${id}`);
                    if (card) {
                        card.remove();
                    }
                    
                    if (document.querySelectorAll('.report-card').length === 0) {
                        window.location.reload();
                    }
                } else {
                    alert('Failed to delete the report. You may not have permission.');
                }
            } catch (err) {
                console.error(err);
                alert('A network error occurred while trying to delete the report.');
            }
        }
    </script>
</body>
</html>
